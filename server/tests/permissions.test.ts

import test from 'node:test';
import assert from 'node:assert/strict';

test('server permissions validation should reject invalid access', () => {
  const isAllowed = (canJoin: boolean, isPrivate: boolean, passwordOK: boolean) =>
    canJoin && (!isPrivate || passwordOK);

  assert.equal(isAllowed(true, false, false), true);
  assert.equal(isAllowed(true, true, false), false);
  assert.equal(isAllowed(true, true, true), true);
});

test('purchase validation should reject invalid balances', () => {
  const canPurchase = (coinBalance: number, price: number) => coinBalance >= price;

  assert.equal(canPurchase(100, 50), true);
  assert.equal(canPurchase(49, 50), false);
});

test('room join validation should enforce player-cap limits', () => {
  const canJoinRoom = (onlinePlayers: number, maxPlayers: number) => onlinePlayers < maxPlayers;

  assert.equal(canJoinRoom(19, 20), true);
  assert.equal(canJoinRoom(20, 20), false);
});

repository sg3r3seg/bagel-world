* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  background: #0d1117;
  color: #f5f7fa;
  font-family: 'Segoe UI', Tahoma, sans-serif;
}

body {
  min-height: 100vh;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, #0d1117, #111827 35%, #0b1320);
  color: #eaf6ff;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1280px;
  margin: 0 auto;
  padding: 20px 24px;
}

.brand {
  font-size: 1.4rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.menu {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.menu button {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  color: #eaf6ff;
  border-radius: 10px;
  padding: 10px 14px;
}

.menu .active {
  background: linear-gradient(135deg, #ff9b63, #ffb867);
  color: #191514;
  border-color: transparent;
}

.main-panel {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px 32px;
}

.hero-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  background: linear-gradient(135deg, rgba(35, 64, 95, 0.9), rgba(19, 28, 37, 0.92));
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 22px;
  padding: 24px 28px;
  margin-bottom: 24px;
}

.eyebrow {
  color: #9fd6ff;
  font-weight: 700;
  margin-bottom: 8px;
}

.hero-banner h1 {
  margin: 0 0 12px;
  font-size: clamp(2rem, 4vw, 4rem);
}

.primary-button {
  background: linear-gradient(135deg, #ff8d5f, #f4be5d);
  border: none;
  color: #191614;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 800;
}

.controls-grid {
  display: grid;
  grid-template-columns: minmax(0, 2.1fr) minmax(300px, 0.9fr);
  gap: 20px;
}

.card {
  background: rgba(17, 24, 39, 0.8);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 18px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 16px;
}

.section-header h2,
.create-box h2 {
  margin: 0;
}

.search-wrap {
  flex: 1;
  max-width: 260px;
}

.search-wrap input,
.create-box input,
.create-box textarea,
.filter-row select {
  width: 100%;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.04);
  color: #eefbff;
  border-radius: 12px;
  padding: 10px 12px;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.filter-row select {
  max-width: 220px;
}

.filter-row button,
.server-actions button {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  color: #eefaff;
  border-radius: 12px;
  padding: 10px 14px;
}

.server-list {
  display: grid;
  gap: 14px;
}

.server-item {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 14px;
}

.server-main {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: start;
}

.server-main h3 {
  margin: 0 0 6px;
  font-size: 1.2rem;
}

.server-main p,
.server-meta,
.empty,
.notice,
.invite-box {
  margin: 0;
  color: #d3e6f7;
}

.status {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.75rem;
  text-transform: uppercase;
  font-weight: 700;
}

.status.online {
  background: rgba(74, 222, 128, 0.12);
  color: #9bf7b2;
}

.status.full {
  background: rgba(248, 113, 113, 0.12);
  color: #ffb0b0;
}

.status.maintenance {
  background: rgba(251, 191, 36, 0.12);
  color: #f7d38c;
}

.server-meta {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 0.86rem;
  color: #c1d9ef;
  margin: 10px 0 12px;
}

.server-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.create-box {
  display: grid;
  gap: 14px;
}

.create-box label {
  display: grid;
  gap: 8px;
  font-weight: 600;
}

.checkbox-row {
  display: flex !important;
  align-items: center;
  gap: 12px;
}

.checkbox-row input {
  width: auto;
}

.wide {
  width: 100%;
}

.invite-box,
.notice {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 12px;
  padding: 10px 12px;
}

@media (max-width: 800px) {
  .controls-grid {
    grid-template-columns: 1fr;
  }

  .hero-banner,
  .section-header,
  .server-main {
    flex-direction: column;
    align-items: stretch;
  }

  .search-wrap {
    max-width: none;
  }
}
